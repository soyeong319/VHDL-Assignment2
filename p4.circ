  <vhdl appearance="logisim_evolution" name="vote25">--library and package&#13;
library ieee;&#13;
use ieee.std_logic_1164.all;&#13;
use ieee.std_logic_arith.all;&#13;
use ieee.std_logic_unsigned.all;&#13;
&#13;
--entity&#13;
entity vote25 is&#13;
    port(&#13;
        vt     :in  std_logic_vector(25 downto 1);&#13;
        result :out std_logic&#13;
    );&#13;
end entity vote25;&#13;
&#13;
--architecture&#13;
architecture bhv of vote25 is&#13;
begin&#13;
    process(vt)&#13;
        variable sum:integer range 0 to 25;&#13;
    begin&#13;
        sum:= 0;&#13;
        for i in 1 to 25 loop&#13;
            if (vt(i)='1') then&#13;
                sum:=sum+1;&#13;
            end if;&#13;
        end loop;&#13;
        if sum &gt;= 13 then&#13;
            result &lt;= '1';&#13;
        else&#13;
            result &lt;= '0';&#13;
        end if;&#13;
    end process;&#13;
end architecture bhv;&#13;
</vhdl>
